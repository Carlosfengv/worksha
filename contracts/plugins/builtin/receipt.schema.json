{
  "$defs": {
    "Composition": {
      "additionalProperties": false,
      "properties": {
        "disabledPluginIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "profile": {
          "$ref": "#/$defs/Profile"
        },
        "removedPluginIds": {
          "description": "Removing a bundled plugin unregisters its functionality; the signed app\nremains the trusted reinstall source. Historical domain data is retained.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "profile",
        "disabledPluginIds"
      ],
      "type": "object"
    },
    "Decimal": {
      "maxLength": 20,
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "type": "string"
    },
    "Profile": {
      "enum": [
        "desktop",
        "background",
        "recovery"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "composition": {
      "$ref": "#/$defs/Composition"
    },
    "operationId": {
      "type": "string"
    },
    "revision": {
      "$ref": "#/$defs/Decimal"
    },
    "storeId": {
      "type": "string"
    }
  },
  "required": [
    "operationId",
    "storeId",
    "revision",
    "composition"
  ],
  "title": "CompositionReceipt",
  "type": "object"
}
