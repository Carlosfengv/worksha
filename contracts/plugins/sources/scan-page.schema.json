{
  "$defs": {
    "ActivityCandidate": {
      "additionalProperties": false,
      "properties": {
        "durationMs": {
          "anyOf": [
            {
              "$ref": "#/$defs/Decimal"
            },
            {
              "type": "null"
            }
          ],
          "description": "Historical source duration; does not establish a host monotonic sample."
        },
        "nativeId": {
          "type": "string"
        },
        "occurredAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "phase": {
          "$ref": "#/$defs/ActivityPhase"
        },
        "responseRef": {
          "type": [
            "string",
            "null"
          ]
        },
        "sessionRef": {
          "type": "string"
        }
      },
      "required": [
        "nativeId",
        "sessionRef",
        "phase"
      ],
      "type": "object"
    },
    "ActivityPhase": {
      "oneOf": [
        {
          "enum": [
            "thinking",
            "generating",
            "tool",
            "idle",
            "unknown"
          ],
          "type": "string"
        },
        {
          "const": "running",
          "description": "An explicit source status; no host timing or token rate is implied.",
          "type": "string"
        }
      ]
    },
    "Checkpoint": {
      "additionalProperties": false,
      "properties": {
        "batches": {
          "$ref": "#/$defs/Decimal"
        },
        "complete": {
          "description": "Transport finished; coverage separately describes incomplete source evidence.",
          "type": "boolean"
        },
        "coverage": {
          "$ref": "#/$defs/Coverage"
        },
        "records": {
          "$ref": "#/$defs/Decimal"
        },
        "sourceRevision": {
          "type": "string"
        }
      },
      "required": [
        "sourceRevision",
        "batches",
        "records",
        "complete",
        "coverage"
      ],
      "type": "object"
    },
    "Coverage": {
      "enum": [
        "complete",
        "partial",
        "unavailable"
      ],
      "type": "string"
    },
    "Decimal": {
      "maxLength": 20,
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "type": "string"
    },
    "FactBatch": {
      "additionalProperties": false,
      "properties": {
        "batchId": {
          "$ref": "#/$defs/Decimal"
        },
        "records": {
          "items": {
            "$ref": "#/$defs/FactCandidate"
          },
          "type": "array"
        },
        "sourceRevision": {
          "type": "string"
        }
      },
      "required": [
        "sourceRevision",
        "batchId",
        "records"
      ],
      "type": "object"
    },
    "FactCandidate": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "project",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/ProjectCandidate"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "session",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/SessionCandidate"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "response",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/ResponseCandidate"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "activity",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/ActivityCandidate"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "write",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/WriteCandidate"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "mcp-catalog",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/McpCatalogCandidate"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "mcp-execution",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/McpExecutionCandidate"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        }
      ]
    },
    "McpCatalogCandidate": {
      "additionalProperties": false,
      "properties": {
        "nativeId": {
          "type": "string"
        },
        "serverName": {
          "type": "string"
        },
        "toolNames": {
          "description": "None means not observed; an observed empty catalog is Some([]).",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "required": [
        "nativeId",
        "serverName"
      ],
      "type": "object"
    },
    "McpExecutionCandidate": {
      "additionalProperties": false,
      "properties": {
        "durationMs": {
          "anyOf": [
            {
              "$ref": "#/$defs/Decimal"
            },
            {
              "type": "null"
            }
          ]
        },
        "nativeId": {
          "type": "string"
        },
        "occurredAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "outcome": {
          "$ref": "#/$defs/Outcome"
        },
        "responseRef": {
          "type": [
            "string",
            "null"
          ]
        },
        "serverRef": {
          "type": [
            "string",
            "null"
          ]
        },
        "sessionRef": {
          "type": [
            "string",
            "null"
          ]
        },
        "toolName": {
          "type": "string"
        }
      },
      "required": [
        "nativeId",
        "toolName",
        "outcome"
      ],
      "type": "object"
    },
    "Outcome": {
      "enum": [
        "success",
        "failure",
        "unknown"
      ],
      "type": "string"
    },
    "ProjectCandidate": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "nativeId": {
          "type": "string"
        },
        "pathHint": {
          "description": "Display evidence only. Never passed to native identity/filesystem readers.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "nativeId",
        "name"
      ],
      "type": "object"
    },
    "ResponseCandidate": {
      "additionalProperties": false,
      "properties": {
        "durationMs": {
          "anyOf": [
            {
              "$ref": "#/$defs/Decimal"
            },
            {
              "type": "null"
            }
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "nativeId": {
          "type": "string"
        },
        "occurredAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "outcome": {
          "$ref": "#/$defs/Outcome"
        },
        "productId": {
          "type": [
            "string",
            "null"
          ]
        },
        "reportedResponseId": {
          "description": "A source claim, never sufficient for cross-source gateway correlation.",
          "type": [
            "string",
            "null"
          ]
        },
        "sessionRef": {
          "type": "string"
        },
        "usage": {
          "$ref": "#/$defs/Usage"
        }
      },
      "required": [
        "nativeId",
        "sessionRef",
        "outcome",
        "usage"
      ],
      "type": "object"
    },
    "SessionCandidate": {
      "additionalProperties": false,
      "properties": {
        "createdAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "nativeId": {
          "type": "string"
        },
        "partial": {
          "type": "boolean"
        },
        "productIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "projectRef": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": "string"
        },
        "unknownClient": {
          "type": "boolean"
        },
        "updatedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "usage": {
          "$ref": "#/$defs/Usage"
        }
      },
      "required": [
        "nativeId",
        "productIds",
        "unknownClient",
        "title",
        "usage",
        "partial"
      ],
      "type": "object"
    },
    "Usage": {
      "additionalProperties": false,
      "properties": {
        "cacheWriteInputTokens": {
          "anyOf": [
            {
              "$ref": "#/$defs/Decimal"
            },
            {
              "type": "null"
            }
          ]
        },
        "cachedInputTokens": {
          "anyOf": [
            {
              "$ref": "#/$defs/Decimal"
            },
            {
              "type": "null"
            }
          ]
        },
        "inputTokens": {
          "anyOf": [
            {
              "$ref": "#/$defs/Decimal"
            },
            {
              "type": "null"
            }
          ]
        },
        "outputTokens": {
          "anyOf": [
            {
              "$ref": "#/$defs/Decimal"
            },
            {
              "type": "null"
            }
          ]
        },
        "reasoningOutputTokens": {
          "anyOf": [
            {
              "$ref": "#/$defs/Decimal"
            },
            {
              "type": "null"
            }
          ]
        },
        "totalTokens": {
          "anyOf": [
            {
              "$ref": "#/$defs/Decimal"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "WriteCandidate": {
      "additionalProperties": false,
      "properties": {
        "nativeId": {
          "type": "string"
        },
        "occurredAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "outcome": {
          "$ref": "#/$defs/Outcome"
        },
        "projectRef": {
          "type": "string"
        },
        "relativePath": {
          "type": "string"
        },
        "responseRef": {
          "type": [
            "string",
            "null"
          ]
        },
        "sessionRef": {
          "type": "string"
        }
      },
      "required": [
        "nativeId",
        "sessionRef",
        "projectRef",
        "relativePath",
        "outcome"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "batch": {
      "anyOf": [
        {
          "$ref": "#/$defs/FactBatch"
        },
        {
          "type": "null"
        }
      ]
    },
    "checkpoint": {
      "anyOf": [
        {
          "$ref": "#/$defs/Checkpoint"
        },
        {
          "type": "null"
        }
      ]
    },
    "nextCursor": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "title": "ScanPage",
  "type": "object"
}
