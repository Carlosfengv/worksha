        "pluginId",
        "digest"
      ],
      "type": "object"
    },
    "StateAction": {
      "enum": [
        "enable",
        "disable",
        "remove",
        "rollback",
        "revoke-grants",
        "revoke-publisher"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action": {
      "$ref": "#/$defs/StateAction"
    },
    "package": {
      "$ref": "#/$defs/PackageQuery"
    }
  },
  "required": [
    "package",
    "action"
  ],
  "title": "StateChange",
  "type": "object"
}
