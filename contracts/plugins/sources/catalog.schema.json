{
  "$defs": {
    "Agent": {
      "additionalProperties": false,
      "properties": {
        "displayName": {
          "type": "string"
        },
        "productId": {
          "type": "string"
        }
      },
      "required": [
        "productId",
        "displayName"
      ],
      "type": "object"
    },
    "Coverage": {
      "enum": [
        "complete",
        "partial",
        "unavailable"
      ],
      "type": "string"
    },
    "Decimal": {
      "maxLength": 20,
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "type": "string"
    },
    "FactSummary": {
      "additionalProperties": false,
      "properties": {
        "activities": {
          "anyOf": [
            {
              "$ref": "#/$defs/Decimal"
            },
            {
              "type": "null"
            }
          ]
        },
        "coverage": {
          "$ref": "#/$defs/Coverage"
        },
        "crossSourceOverlapUnknown": {
          "description": "Source-reported IDs do not establish overlap with other sources or the gateway.",
          "type": "boolean"
        },
        "mcpCatalogs": {
          "anyOf": [
            {
              "$ref": "#/$defs/Decimal"
            },
            {
              "type": "null"
            }
          ]
        },
        "mcpExecutions": {
          "anyOf": [
            {
              "$ref": "#/$defs/Decimal"
            },
            {
              "type": "null"
            }
          ]
        },
        "projects": {
          "anyOf": [
            {
              "$ref": "#/$defs/Decimal"
            },
            {
              "type": "null"
            }
          ]
        },
        "responses": {
          "$ref": "#/$defs/UnitUsage"
        },
        "sessions": {
          "$ref": "#/$defs/UnitUsage"
        },
        "sourceId": {
          "type": "string"
        },
        "successfulWriteReports": {
          "anyOf": [
            {
              "$ref": "#/$defs/Decimal"
            },
            {
              "type": "null"
            }
          ]
        },
        "writeReports": {
          "anyOf": [
            {
              "$ref": "#/$defs/Decimal"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "sourceId",
        "coverage",
        "sessions",
        "responses",
        "crossSourceOverlapUnknown"
      ],
      "type": "object"
    },
    "Freshness": {
      "enum": [
        "unread",
        "current",
        "stale",
        "failed"
      ],
      "type": "string"
    },
    "Manifest": {
      "additionalProperties": false,
      "properties": {
        "agent": {
          "anyOf": [
            {
              "$ref": "#/$defs/Agent"
            },
            {
              "type": "null"
            }
          ]
        },
        "capabilities": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "displayName": {
          "type": "string"
        },
        "hostApi": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/PackageKind"
            },
            {
              "type": "null"
            }
          ]
        },
        "manifestVersion": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "permissions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Permission"
          },
          "type": "array"
        },
        "providers": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ProviderPreset"
          },
          "type": "array"
        },
        "publisher": {
          "type": "string"
        },
        "requires": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "runtime": {
          "$ref": "#/$defs/Runtime"
        },
        "settings": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Setting"
          },
          "type": "array"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/Source"
            },
            {
              "type": "null"
            }
          ]
        },
        "version": {
          "type": "string"
        },
        "views": {
          "default": [],
          "items": {
            "$ref": "#/$defs/View"
          },
          "type": "array"
        }
      },
      "required": [
        "manifestVersion",
        "id",
        "version",
        "displayName",
        "publisher",
        "hostApi",
        "runtime",
        "capabilities"
      ],
      "type": "object"
    },
    "PackageKind": {
      "enum": [
        "routing-policy"
      ],
      "type": "string"
    },
    "Permission": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "source.content.read",
              "type": "string"
            },
            "resource": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "resource"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "connection.request",
              "type": "string"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "path"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "ui.contribute",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "domain.query",
              "type": "string"
            },
            "query": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "query"
          ],
          "type": "object"
        }
      ]
    },
    "Product": {
      "additionalProperties": false,
      "properties": {
        "displayName": {
          "type": "string"
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "displayName"
      ],
      "type": "object"
    },
    "ProviderPreset": {
      "additionalProperties": false,
      "properties": {
        "endpoint": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "protocol": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "protocol",
        "endpoint",
        "model"
      ],
      "type": "object"
    },
    "Runtime": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "declarative",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "abi": {
              "type": "string"
            },
            "entry": {
              "type": "string"
            },
            "kind": {
              "const": "wasm-component",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "entry",
            "abi"
          ],
          "type": "object"
        }
      ]
    },
    "Setting": {
      "additionalProperties": false,
      "properties": {
        "default": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "options": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "key",
        "label",
        "options",
        "default"
      ],
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Package-local stable name; the host prefixes the plugin namespace.",
          "type": "string"
        },
        "maxAgeSeconds": {
          "description": "For live reporters, a heartbeat older than this is stale.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "products": {
          "items": {
            "$ref": "#/$defs/Product"
          },
          "type": "array"
        },
        "refreshSeconds": {
          "description": "Explicit package opt-in; selecting this resource authorizes periodic reads.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "products"
      ],
      "type": "object"
    },
    "Status": {
      "additionalProperties": false,
      "properties": {
        "activationEpoch": {
          "$ref": "#/$defs/Decimal"
        },
        "digest": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "factSummary": {
          "anyOf": [
            {
              "$ref": "#/$defs/FactSummary"
            },
            {
              "type": "null"
            }
          ]
        },
        "freshness": {
          "$ref": "#/$defs/Freshness"
        },
        "grantRevision": {
          "$ref": "#/$defs/Decimal"
        },
        "manifest": {
          "$ref": "#/$defs/Manifest"
        },
        "persistMetadata": {
          "type": "boolean"
        },
        "problem": {
          "type": [
            "string",
            "null"
          ]
        },
        "publisherTrusted": {
          "type": "boolean"
        },
        "runtimeActive": {
          "type": "boolean"
        },
        "signingKey": {
          "type": "string"
        },
        "sourceAuthorized": {
          "type": "boolean"
        },
        "sourceLabel": {
          "type": [
            "string",
            "null"
          ]
        },
        "unifiedAuthorized": {
          "type": "boolean"
        }
      },
      "required": [
        "manifest",
        "digest",
        "signingKey",
        "enabled",
        "runtimeActive",
        "publisherTrusted",
        "activationEpoch",
        "grantRevision",
        "sourceAuthorized",
        "unifiedAuthorized",
        "persistMetadata",
        "freshness"
      ],
      "type": "object"
    },
    "UnitUsage": {
      "additionalProperties": false,
      "properties": {
        "coverage": {
          "$ref": "#/$defs/Coverage"
        },
        "missingFields": {
          "description": "At least one matching fact lacks this field. Totals include known values only.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "records": {
          "anyOf": [
            {
              "$ref": "#/$defs/Decimal"
            },
            {
              "type": "null"
            }
          ]
        },
        "unit": {
          "$ref": "#/$defs/UsageUnit"
        },
        "usage": {
          "$ref": "#/$defs/Usage"
        }
      },
      "required": [
        "unit",
        "coverage",
        "usage",
        "missingFields"
      ],
      "type": "object"
    },
    "Usage": {
      "additionalProperties": false,
      "properties": {
        "cacheWriteInputTokens": {
          "anyOf": [
            {
              "$ref": "#/$defs/Decimal"
            },
            {
              "type": "null"
            }
          ]
        },
        "cachedInputTokens": {
          "anyOf": [
            {
              "$ref": "#/$defs/Decimal"
            },
            {
              "type": "null"
            }
          ]
        },
        "inputTokens": {
          "anyOf": [
            {
              "$ref": "#/$defs/Decimal"
            },
            {
              "type": "null"
            }
          ]
        },
        "outputTokens": {
          "anyOf": [
            {
              "$ref": "#/$defs/Decimal"
            },
            {
              "type": "null"
            }
          ]
        },
        "reasoningOutputTokens": {
          "anyOf": [
            {
              "$ref": "#/$defs/Decimal"
            },
            {
              "type": "null"
            }
          ]
        },
        "totalTokens": {
          "anyOf": [
            {
              "$ref": "#/$defs/Decimal"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "UsageUnit": {
      "enum": [
        "session-cumulative",
        "model-response"
      ],
      "type": "string"
    },
    "View": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ViewKind"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "description",
        "kind"
      ],
      "type": "object"
    },
    "ViewKind": {
      "enum": [
        "report",
        "sessions",
        "quota",
        "providers",
        "settings"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "type": "string"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/Status"
      },
      "type": "array"
    }
  },
  "required": [
    "apiVersion",
    "items"
  ],
  "title": "Catalog",
  "type": "object"
}
