{
  "$defs": {
    "DataQuery": {
      "additionalProperties": false,
      "properties": {
        "capability": {
          "description": "Versioned host-mediated capability, never an implementation method name.",
          "type": "string"
        },
        "sourceId": {
          "type": "string"
        },
        "viewId": {
          "type": "string"
        }
      },
      "required": [
        "viewId",
        "sourceId",
        "capability"
      ],
      "type": "object"
    },
    "DetailPlacement": {
      "enum": [
        "tab",
        "card"
      ],
      "type": "string"
    },
    "DetailSlot": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "objectIds": {
          "description": "Exact public object IDs or the single wildcard \"*\". Never sent to the guest.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "placement": {
          "$ref": "#/$defs/DetailPlacement"
        },
        "target": {
          "$ref": "#/$defs/DetailTarget"
        },
        "title": {
          "type": "string"
        },
        "viewId": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "target",
        "objectIds",
        "placement",
        "viewId",
        "title"
      ],
      "type": "object"
    },
    "DetailTarget": {
      "enum": [
        "agent",
        "provider",
        "account"
      ],
      "type": "string"
    },
    "Navigation": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "viewId": {
          "description": "An existing host-rendered view, never executable frontend code or a URL.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "viewId"
      ],
      "type": "object"
    },
    "OptionalDependency": {
      "additionalProperties": false,
      "properties": {
        "pluginId": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "views": {
          "description": "Only these existing views degrade. No cross-plugin data or permission is granted.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "pluginId",
        "version",
        "views"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "dataQueries": {
      "items": {
        "$ref": "#/$defs/DataQuery"
      },
      "type": "array"
    },
    "detailSlots": {
      "default": [],
      "items": {
        "$ref": "#/$defs/DetailSlot"
      },
      "type": "array"
    },
    "navigation": {
      "items": {
        "$ref": "#/$defs/Navigation"
      },
      "type": "array"
    },
    "optionalDependencies": {
      "default": [],
      "items": {
        "$ref": "#/$defs/OptionalDependency"
      },
      "type": "array"
    },
    "schemaVersion": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "schemaVersion"
  ],
  "title": "Contributions",
  "type": "object"
}
