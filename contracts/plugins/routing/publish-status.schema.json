{
  "$defs": {
    "AccountAffinity": {
      "enum": [
        "off",
        "prefer",
        "strict"
      ],
      "type": "string"
    },
    "AccountPool": {
      "additionalProperties": false,
      "properties": {
        "accounts": {
          "items": {
            "$ref": "#/$defs/AccountRef"
          },
          "type": "array"
        },
        "affinity": {
          "$ref": "#/$defs/AccountAffinity"
        },
        "modelId": {
          "type": "string"
        },
        "strategy": {
          "$ref": "#/$defs/AccountStrategy"
        },
        "weights": {
          "additionalProperties": {
            "format": "uint16",
            "maximum": 65535,
            "minimum": 0,
            "type": "integer"
          },
          "type": "object"
        }
      },
      "required": [
        "modelId",
        "accounts"
      ],
      "type": "object"
    },
    "AccountRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "revision": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "type": "object"
    },
    "AccountStrategy": {
      "enum": [
        "priority",
        "round-robin",
        "weighted",
        "quota-reset",
        "quota-remaining",
        "quota-pace"
      ],
      "type": "string"
    },
    "BindingStatus": {
      "additionalProperties": false,
      "properties": {
        "authorized": {
          "type": "boolean"
        },
        "errorCode": {
          "type": [
            "string",
            "null"
          ]
        },
        "failureMode": {
          "$ref": "#/$defs/FailureMode"
        },
        "package": {
          "$ref": "#/$defs/PackageQuery"
        },
        "revision": {
          "type": "string"
        },
        "serviceId": {
          "type": "string"
        },
        "serviceVersionId": {
          "type": "string"
        },
        "storeId": {
          "type": "string"
        }
      },
      "required": [
        "storeId",
        "serviceId",
        "serviceVersionId",
        "revision",
        "package",
        "failureMode",
        "authorized"
      ],
      "type": "object"
    },
    "Capabilities": {
      "additionalProperties": false,
      "properties": {
        "contextWindow": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "inputModalities": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "maxOutputTokens": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "thinking": {
          "type": "boolean"
        },
        "tools": {
          "type": "boolean"
        }
      },
      "required": [
        "contextWindow",
        "maxOutputTokens",
        "tools",
        "thinking",
        "inputModalities"
      ],
      "type": "object"
    },
    "ChildServiceRef": {
      "additionalProperties": false,
      "properties": {
        "serviceId": {
          "type": "string"
        },
        "versionId": {
          "type": "string"
        }
      },
      "required": [
        "serviceId",
        "versionId"
      ],
      "type": "object"
    },
    "FailureMode": {
      "enum": [
        "reject",
        "builtin"
      ],
      "type": "string"
    },
    "IntentClassifier": {
      "additionalProperties": false,
      "properties": {
        "account": {
          "anyOf": [
            {
              "$ref": "#/$defs/AccountRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "modelId": {
          "type": "string"
        }
      },
      "required": [
        "modelId"
      ],
      "type": "object"
    },
    "ModelDraft": {
      "additionalProperties": false,
      "properties": {
        "capabilities": {
          "$ref": "#/$defs/Capabilities"
        },
        "child": {
          "anyOf": [
            {
              "$ref": "#/$defs/ChildServiceRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "type": "string"
        },
        "model": {
          "default": "",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "providerId": {
          "default": "",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "capabilities"
      ],
      "type": "object"
    },
    "ModelLimit": {
      "additionalProperties": false,
      "properties": {
        "maxConcurrent": {
          "default": 0,
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "modelId": {
          "default": "",
          "type": "string"
        },
        "requestsPerMinute": {
          "default": 0,
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "OperationAction": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "draft": {
              "$ref": "#/$defs/ServiceDraft"
            },
            "kind": {
              "const": "save",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "draft"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "expectedRevision": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "delete",
              "type": "string"
            },
            "serviceId": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "serviceId",
            "expectedRevision"
          ],
          "type": "object"
        }
      ]
    },
    "OperationRequest": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "#/$defs/OperationAction"
        },
        "operationId": {
          "type": "string"
        },
        "storeId": {
          "type": "string"
        }
      },
      "required": [
        "storeId",
        "operationId",
        "action"
      ],
      "type": "object"
    },
    "PackageQuery": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "type": "string"
        },
        "pluginId": {
          "type": "string"
        }
      },
      "required": [
        "pluginId",
        "digest"
      ],
      "type": "object"
    },
    "RouteRule": {
      "additionalProperties": false,
      "properties": {
        "agent": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "intent": {
          "type": [
            "string",
            "null"
          ]
        },
        "minInputTokens": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "modelId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "projectId": {
          "type": [
            "string",
            "null"
          ]
        },
        "stream": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "tools": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "name",
        "modelId"
      ],
      "type": "object"
    },
    "RoutingPolicy": {
      "additionalProperties": false,
      "properties": {
        "accountPools": {
          "items": {
            "$ref": "#/$defs/AccountPool"
          },
          "type": "array"
        },
        "cooldownSeconds": {
          "default": 30,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "deadlineSeconds": {
          "default": 120,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "disabledModels": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "fallbackAcrossModels": {
          "type": "boolean"
        },
        "fallbackOnAccessDenied": {
          "type": "boolean"
        },
        "fallbackOnFailure": {
          "default": true,
          "type": "boolean"
        },
        "fallbackOnRateLimit": {
          "default": true,
          "type": "boolean"
        },
        "intentClassifier": {
          "anyOf": [
            {
              "$ref": "#/$defs/IntentClassifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "limits": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ModelLimit"
          },
          "type": "array"
        },
        "maxAttempts": {
          "default": 3,
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "order": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "rules": {
          "items": {
            "$ref": "#/$defs/RouteRule"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "ServiceDraft": {
      "additionalProperties": false,
      "properties": {
        "defaultModelId": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "models": {
          "items": {
            "$ref": "#/$defs/ModelDraft"
          },
          "type": "array"
        },
        "name": {
          "type": "string"
        },
        "revision": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "routingPolicy": {
          "$ref": "#/$defs/RoutingPolicy",
          "default": {
            "cooldownSeconds": 30,
            "deadlineSeconds": 120,
            "disabledModels": [],
            "enabled": false,
            "fallbackOnFailure": true,
            "fallbackOnRateLimit": true,
            "limits": [],
            "maxAttempts": 3,
            "order": []
          }
        }
      },
      "required": [
        "id",
        "revision",
        "name",
        "defaultModelId",
        "models"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "binding": {
      "anyOf": [
        {
          "$ref": "#/$defs/BindingStatus"
        },
        {
          "type": "null"
        }
      ]
    },
    "errorCode": {
      "type": [
        "string",
        "null"
      ]
    },
    "operationId": {
      "type": "string"
    },
    "request": {
      "$ref": "#/$defs/OperationRequest"
    },
    "serviceId": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "storeId": {
      "type": "string"
    }
  },
  "required": [
    "storeId",
    "operationId",
    "serviceId",
    "state",
    "request"
  ],
  "title": "PublishStatus",
  "type": "object"
}
