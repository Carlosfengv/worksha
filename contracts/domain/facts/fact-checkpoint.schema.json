{
  "$defs": {
    "Coverage": {
      "enum": [
        "complete",
        "partial",
        "unavailable"
      ],
      "type": "string"
    },
    "Decimal": {
      "maxLength": 20,
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "batches": {
      "$ref": "#/$defs/Decimal"
    },
    "complete": {
      "description": "Transport finished; coverage separately describes incomplete source evidence.",
      "type": "boolean"
    },
    "coverage": {
      "$ref": "#/$defs/Coverage"
    },
    "records": {
      "$ref": "#/$defs/Decimal"
    },
    "sourceRevision": {
      "type": "string"
    }
  },
  "required": [
    "sourceRevision",
    "batches",
    "records",
    "complete",
    "coverage"
  ],
  "title": "Checkpoint",
  "type": "object"
}
