{
  "$defs": {
    "Authorization": {
      "enum": [
        "required",
        "authorized",
        "revoked"
      ],
      "type": "string"
    },
    "Coverage": {
      "enum": [
        "complete",
        "partial",
        "unavailable"
      ],
      "type": "string"
    },
    "Decimal": {
      "maxLength": 20,
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "type": "string"
    },
    "ExactResponseLink": {
      "additionalProperties": false,
      "properties": {
        "attemptId": {
          "type": "string"
        },
        "eventId": {
          "type": "string"
        },
        "responseId": {
          "type": "string"
        },
        "sessionId": {
          "type": "string"
        },
        "usageConflict": {
          "type": "boolean"
        }
      },
      "required": [
        "eventId",
        "sessionId",
        "responseId",
        "attemptId",
        "usageConflict"
      ],
      "type": "object"
    },
    "Freshness": {
      "enum": [
        "unread",
        "current",
        "stale",
        "failed"
      ],
      "type": "string"
    },
    "NativeMatchState": {
      "enum": [
        "exact-response-id",
        "unlinked",
        "ambiguous",
        "identity-conflict",
        "unknown"
      ],
      "type": "string"
    },
    "QueryScope": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/ScopeKind"
        },
        "sourceIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "kind",
        "sourceIds"
      ],
      "type": "object"
    },
    "RequestBilling": {
      "additionalProperties": false,
      "properties": {
        "actual": {
          "items": {
            "$ref": "#/$defs/RequestMoney"
          },
          "type": "array"
        },
        "estimated": {
          "items": {
            "$ref": "#/$defs/RequestMoney"
          },
          "type": "array"
        },
        "unknownParts": {
          "$ref": "#/$defs/Decimal",
          "description": "Missing billing evidence parts, not missing request/response count."
        }
      },
      "required": [
        "actual",
        "estimated",
        "unknownParts"
      ],
      "type": "object"
    },
    "RequestEvidence": {
      "enum": [
        "host-observed",
        "source-reported"
      ],
      "type": "string"
    },
    "RequestEvidenceDetail": {
      "additionalProperties": false,
      "properties": {
        "billing": {
          "anyOf": [
            {
              "$ref": "#/$defs/RequestBilling"
            },
            {
              "type": "null"
            }
          ]
        },
        "matching": {
          "$ref": "#/$defs/RequestMatching"
        },
        "overflowFields": {
          "description": "Overflow in captured attempt totals is unknown, never a capped value.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "timingNote": {
          "description": "Preserves distinctions between source event timing and host HTTP timing.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "matching",
        "overflowFields"
      ],
      "type": "object"
    },
    "RequestEvidenceSummary": {
      "additionalProperties": false,
      "properties": {
        "billing": {
          "anyOf": [
            {
              "$ref": "#/$defs/RequestBilling"
            },
            {
              "type": "null"
            }
          ]
        },
        "matching": {
          "$ref": "#/$defs/RequestMatchingSummary"
        },
        "overflowFields": {
          "description": "A sum outside u64 is unknown; original per-record values remain intact.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "usageMissingParts": {
          "anyOf": [
            {
              "$ref": "#/$defs/Decimal"
            },
            {
              "type": "null"
            }
          ],
          "description": "Missing underlying usage parts, distinct from records with incomplete usage."
        }
      },
      "required": [
        "matching",
        "overflowFields"
      ],
      "type": "object"
    },
    "RequestFilter": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "outcome": {
          "type": [
            "string",
            "null"
          ]
        },
        "productId": {
          "type": [
            "string",
            "null"
          ]
        },
        "projectId": {
          "type": [
            "string",
            "null"
          ]
        },
        "providerKey": {
          "type": [
            "string",
            "null"
          ]
        },
        "search": {
          "type": [
            "string",
            "null"
          ]
        },
        "sessionId": {
          "type": [
            "string",
            "null"
          ]
        },
        "start": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "RequestMatching": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "attemptId": {
              "type": [
                "string",
                "null"
              ]
            },
            "kind": {
              "const": "native-response",
              "type": "string"
            },
            "logicalRequestId": {
              "type": [
                "string",
                "null"
              ]
            },
            "responseId": {
              "type": [
                "string",
                "null"
              ]
            },
            "state": {
              "$ref": "#/$defs/NativeMatchState"
            },
            "usageConflict": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "state",
            "usageConflict"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "gateway-request",
              "type": "string"
            },
            "links": {
              "items": {
                "$ref": "#/$defs/ExactResponseLink"
              },
              "type": "array"
            },
            "linksLimited": {
              "type": "boolean"
            },
            "matchedResponses": {
              "$ref": "#/$defs/Decimal"
            }
          },
          "required": [
            "kind",
            "matchedResponses",
            "links",
            "linksLimited"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "source-reported",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "RequestMatchingSummary": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "ambiguous": {
              "$ref": "#/$defs/Decimal"
            },
            "exact": {
              "$ref": "#/$defs/Decimal"
            },
            "identityConflicts": {
              "$ref": "#/$defs/Decimal"
            },
            "kind": {
              "const": "native-responses",
              "type": "string"
            },
            "unknown": {
              "$ref": "#/$defs/Decimal"
            },
            "unlinked": {
              "$ref": "#/$defs/Decimal"
            },
            "usageConflicts": {
              "$ref": "#/$defs/Decimal"
            }
          },
          "required": [
            "kind",
            "exact",
            "unlinked",
            "ambiguous",
            "identityConflicts",
            "unknown",
            "usageConflicts"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "gateway-requests",
              "type": "string"
            },
            "matchedResponses": {
              "$ref": "#/$defs/Decimal"
            },
            "usageConflictLinks": {
              "$ref": "#/$defs/Decimal"
            },
            "withExactLinks": {
              "$ref": "#/$defs/Decimal"
            },
            "withoutConfirmedLinks": {
              "$ref": "#/$defs/Decimal"
            }
          },
          "required": [
            "kind",
            "withExactLinks",
            "withoutConfirmedLinks",
            "matchedResponses",
            "usageConflictLinks"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "source-reported",
              "type": "string"
            },
            "unverifiedRecords": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Decimal"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "RequestMoney": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "description": "Finite nonnegative decimal text from the existing host monetary value.\nNo currency conversion or claim of greater precision is introduced.",
          "maxLength": 400,
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "type": "string"
        },
        "currency": {
          "pattern": "^[A-Z][A-Z0-9]{0,15}$",
          "type": "string"
        },
        "parts": {
          "$ref": "#/$defs/Decimal"
        }
      },
      "required": [
        "currency",
        "amount",
        "parts"
      ],
      "type": "object"
    },
    "RequestQueryRecord": {
      "additionalProperties": false,
      "properties": {
        "attempts": {
          "anyOf": [
            {
              "$ref": "#/$defs/Decimal"
            },
            {
              "type": "null"
            }
          ]
        },
        "durationMs": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "endedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "occurredAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "outcome": {
          "type": "string"
        },
        "productId": {
          "type": [
            "string",
            "null"
          ]
        },
        "projectName": {
          "type": [
            "string",
            "null"
          ]
        },
        "projectRef": {
          "type": [
            "string",
            "null"
          ]
        },
        "providerKey": {
          "type": "string"
        },
        "providerName": {
          "type": "string"
        },
        "sessionRef": {
          "type": [
            "string",
            "null"
          ]
        },
        "sessionTitle": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceId": {
          "type": "string"
        },
        "throughput": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "ttftMs": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "$ref": "#/$defs/RequestUnit"
        },
        "usage": {
          "$ref": "#/$defs/Usage"
        },
        "usageMissing": {
          "$ref": "#/$defs/Decimal"
        }
      },
      "required": [
        "id",
        "sourceId",
        "unit",
        "providerKey",
        "providerName",
        "outcome",
        "usage",
        "usageMissing"
      ],
      "type": "object"
    },
    "RequestSort": {
      "enum": [
        "time",
        "tokens",
        "duration",
        "ttft",
        "cost-usd"
      ],
      "type": "string"
    },
    "RequestSourceSummary": {
      "additionalProperties": false,
      "properties": {
        "attempts": {
          "anyOf": [
            {
              "$ref": "#/$defs/Decimal"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source-reported responses do not establish an HTTP attempt count."
        },
        "coverage": {
          "$ref": "#/$defs/Coverage"
        },
        "evidence": {
          "$ref": "#/$defs/RequestEvidence"
        },
        "evidenceSummary": {
          "anyOf": [
            {
              "$ref": "#/$defs/RequestEvidenceSummary"
            },
            {
              "type": "null"
            }
          ]
        },
        "records": {
          "anyOf": [
            {
              "$ref": "#/$defs/Decimal"
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceId": {
          "type": "string"
        },
        "unit": {
          "$ref": "#/$defs/RequestUnit"
        },
        "unknownTime": {
          "anyOf": [
            {
              "$ref": "#/$defs/Decimal"
            },
            {
              "type": "null"
            }
          ],
          "description": "Matching non-time filters but excluded from a dated range when time is unknown."
        },
        "usage": {
          "$ref": "#/$defs/Usage"
        },
        "usageMissing": {
          "anyOf": [
            {
              "$ref": "#/$defs/Decimal"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "sourceId",
        "unit",
        "evidence",
        "coverage",
        "usage"
      ],
      "type": "object"
    },
    "RequestUnit": {
      "enum": [
        "model-response",
        "logical-request"
      ],
      "type": "string"
    },
    "ScopeKind": {
      "enum": [
        "builtin",
        "external",
        "combined"
      ],
      "type": "string"
    },
    "SourceState": {
      "additionalProperties": false,
      "properties": {
        "authorization": {
          "$ref": "#/$defs/Authorization"
        },
        "coverage": {
          "$ref": "#/$defs/Coverage"
        },
        "freshness": {
          "$ref": "#/$defs/Freshness"
        },
        "problem": {
          "description": "Host-owned fixed reason code, never guest text.",
          "type": [
            "string",
            "null"
          ]
        },
        "sourceId": {
          "type": "string"
        }
      },
      "required": [
        "sourceId",
        "authorization",
        "freshness",
        "coverage"
      ],
      "type": "object"
    },
    "UnifiedRequestItem": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "$ref": "#/$defs/RequestEvidence"
        },
        "evidenceDetail": {
          "anyOf": [
            {
              "$ref": "#/$defs/RequestEvidenceDetail"
            },
            {
              "type": "null"
            }
          ]
        },
        "hostRequestId": {
          "description": "Only host records can open the existing request/attempt/billing detail.",
          "type": [
            "string",
            "null"
          ]
        },
        "record": {
          "$ref": "#/$defs/RequestQueryRecord"
        },
        "reportedDurationMs": {
          "anyOf": [
            {
              "$ref": "#/$defs/Decimal"
            },
            {
              "type": "null"
            }
          ]
        },
        "reportedResponseId": {
          "description": "Not an exact host link and never used for deduplication.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "record",
        "evidence"
      ],
      "type": "object"
    },
    "UnifiedRequestQuery": {
      "additionalProperties": false,
      "properties": {
        "cursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "descending": {
          "description": "Event time ordered to milliseconds; unknown times always follow known times.",
          "type": "boolean"
        },
        "filter": {
          "$ref": "#/$defs/RequestFilter"
        },
        "includeEvidence": {
          "description": "Opt in to frozen host matching/billing evidence, never guest claims.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "scope": {
          "$ref": "#/$defs/QueryScope"
        },
        "snapshotToken": {
          "type": [
            "string",
            "null"
          ]
        },
        "sort": {
          "anyOf": [
            {
              "$ref": "#/$defs/RequestSort"
            },
            {
              "type": "null"
            }
          ],
          "description": "Omitted requests keep the original event-time order and JSON shape."
        },
        "unit": {
          "$ref": "#/$defs/RequestUnit"
        }
      },
      "required": [
        "scope",
        "unit",
        "filter",
        "descending"
      ],
      "type": "object"
    },
    "Usage": {
      "additionalProperties": false,
      "properties": {
        "cacheWriteInputTokens": {
          "anyOf": [
            {
              "$ref": "#/$defs/Decimal"
            },
            {
              "type": "null"
            }
          ]
        },
        "cachedInputTokens": {
          "anyOf": [
            {
              "$ref": "#/$defs/Decimal"
            },
            {
              "type": "null"
            }
          ]
        },
        "inputTokens": {
          "anyOf": [
            {
              "$ref": "#/$defs/Decimal"
            },
            {
              "type": "null"
            }
          ]
        },
        "outputTokens": {
          "anyOf": [
            {
              "$ref": "#/$defs/Decimal"
            },
            {
              "type": "null"
            }
          ]
        },
        "reasoningOutputTokens": {
          "anyOf": [
            {
              "$ref": "#/$defs/Decimal"
            },
            {
              "type": "null"
            }
          ]
        },
        "totalTokens": {
          "anyOf": [
            {
              "$ref": "#/$defs/Decimal"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "appliedQuery": {
      "$ref": "#/$defs/UnifiedRequestQuery"
    },
    "asOf": {
      "type": "string"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/UnifiedRequestItem"
      },
      "type": "array"
    },
    "nextCursor": {
      "type": [
        "string",
        "null"
      ]
    },
    "overlapUnknown": {
      "type": "boolean"
    },
    "snapshotToken": {
      "type": "string"
    },
    "sourceStates": {
      "items": {
        "$ref": "#/$defs/SourceState"
      },
      "type": "array"
    },
    "sourceSummaries": {
      "description": "Full filtered scope, never just the current page. No cross-source total.",
      "items": {
        "$ref": "#/$defs/RequestSourceSummary"
      },
      "type": "array"
    }
  },
  "required": [
    "items",
    "snapshotToken",
    "asOf",
    "sourceStates",
    "sourceSummaries",
    "appliedQuery",
    "overlapUnknown"
  ],
  "title": "UnifiedRequestPage",
  "type": "object"
}
