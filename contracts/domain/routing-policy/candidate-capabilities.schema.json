{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contextWindow": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "inputModalities": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "maxOutputTokens": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "thinking": {
      "type": "boolean"
    },
    "tools": {
      "type": "boolean"
    }
  },
  "required": [
    "contextWindow",
    "maxOutputTokens",
    "tools",
    "thinking",
    "inputModalities"
  ],
  "title": "CandidateCapabilities",
  "type": "object"
}
