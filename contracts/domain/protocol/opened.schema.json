{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A native adapter can retain a parsed request without an encode/decode round trip.\nLegacy guests can only produce their existing validated wire-byte response.",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "json",
          "type": "string"
        },
        "value": true
      },
      "required": [
        "kind",
        "value"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "bytes",
          "type": "string"
        },
        "value": {
          "items": {
            "format": "uint8",
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "type": "object"
    }
  ],
  "title": "Opened"
}
