{
  "$defs": {
    "Choice": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "type": "string"
        },
        "pluginId": {
          "type": "string"
        }
      },
      "required": [
        "pluginId",
        "digest"
      ],
      "type": "object"
    },
    "Policy": {
      "additionalProperties": false,
      "properties": {
        "baseProtocol": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "schemaVersion": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "schemaVersion",
        "baseProtocol",
        "path"
      ],
      "type": "object"
    },
    "Selection": {
      "additionalProperties": false,
      "properties": {
        "bindingId": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "pluginId": {
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/Target"
        }
      },
      "required": [
        "pluginId",
        "digest",
        "bindingId",
        "target"
      ],
      "type": "object"
    },
    "SourceKind": {
      "enum": [
        "builtin",
        "external",
        "pending",
        "changed"
      ],
      "type": "string"
    },
    "Target": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "expectedRevision": {
              "type": "string"
            },
            "kind": {
              "const": "saved",
              "type": "string"
            },
            "providerId": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "providerId",
            "expectedRevision"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "credentialRef": {
              "type": [
                "string",
                "null"
              ]
            },
            "endpoint": {
              "type": "string"
            },
            "kind": {
              "const": "draft",
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "protocol": {
              "type": "string"
            },
            "vendor": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "label",
            "endpoint",
            "protocol",
            "vendor"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authorized": {
      "type": "boolean"
    },
    "choice": {
      "anyOf": [
        {
          "$ref": "#/$defs/Choice"
        },
        {
          "type": "null"
        }
      ]
    },
    "errorCode": {
      "type": [
        "string",
        "null"
      ]
    },
    "expectedRevision": {
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/SourceKind"
    },
    "policy": {
      "anyOf": [
        {
          "$ref": "#/$defs/Policy"
        },
        {
          "type": "null"
        }
      ]
    },
    "providerId": {
      "type": "string"
    },
    "selection": {
      "anyOf": [
        {
          "$ref": "#/$defs/Selection"
        },
        {
          "type": "null"
        }
      ]
    },
    "sourceRevision": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "providerId",
    "expectedRevision",
    "kind",
    "authorized"
  ],
  "title": "SourceState",
  "type": "object"
}
